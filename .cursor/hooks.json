{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/agents/guardrails.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\""
      }
    ],
    "sessionStart": [
      {
        "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agents/cursor_state.py\""
      }
    ],
    "preToolUse": [
      {
        "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agents/cursor_state.py\""
      }
    ],
    "postToolUse": [
      {
        "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agents/cursor_state.py\""
      }
    ],
    "stop": [
      {
        "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agents/cursor_state.py\""
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agents/cursor_state.py\""
      }
    ]
  }
}
