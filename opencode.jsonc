{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git diff": "allow",
      "git log *": "allow",
      "git log": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git branch": "allow",
      "git rev-parse *": "allow",
      "git remote -v*": "allow",
      "git remote -v": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "sed *": "allow",
      "python3 *": "allow",
      "node *": "allow",
      "bash *": "allow",
      "sh *": "allow",
      "bk *": "allow",
      "gh pr view *": "allow",
      "gh issue view *": "allow",
      "gh workflow *": "ask",
      "git push *": "deny",
      "git push": "deny",
      "git tag *": "deny",
      "git tag": "deny",
      "gh release create *": "deny",
      "gh release create": "deny",
      "gh pr merge *": "deny",
      "gh pr merge": "deny",
      "bk say *": "deny",
      "bk say": "deny",
      "bk approve *": "deny",
      "bk approve": "deny",
      "* --no-verify*": "deny",
      "* --no-verify": "deny",
      "git *--no-verify*": "deny"
    },
    "edit": {
      "*": "allow",
      ".github/**": "ask",
      "package.json": "ask",
      "**/package.json": "ask",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny"
    }
  },
  "plugins": [
    {
      "package": "./.opencode/plugins/bk-guardrails",
      "options": {
        "scriptsDir": "./scripts/agents"
      }
    }
  ]
}
