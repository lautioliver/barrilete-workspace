{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/agents/guardrails.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\"",
            "statusMessage": "Guardrails: checking the command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/hooks/codex_handoff.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/hooks/codex_handoff.py\""
          },
          {
            "type": "command",
            "command": "[ -n \"${BK_TASK_DIR:-}\" ] || exit 0; f=\"${CLAUDE_PROJECT_DIR:-.}/scripts/agents/task_events.py\"; [ -f \"$f\" ] || f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/agents/task_events.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/hooks/codex_handoff.py\""
          },
          {
            "type": "command",
            "command": "[ -n \"${BK_TASK_DIR:-}\" ] || exit 0; f=\"${CLAUDE_PROJECT_DIR:-.}/scripts/agents/task_events.py\"; [ -f \"$f\" ] || f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/agents/task_events.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/hooks/codex_handoff.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${BK_TASK_DIR:-}\" ] || exit 0; in=$(cat); case \"$in\" in *git*commit*|*gh*pr*create*) ;; *) exit 0 ;; esac; f=\"${CLAUDE_PROJECT_DIR:-.}/scripts/agents/task_events.py\"; [ -f \"$f\" ] || f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/agents/task_events.py\"; [ -f \"$f\" ] || exit 0; printf '%s' \"$in\" | python3 \"$f\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/hooks/codex_handoff.py\""
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/hooks/codex_handoff.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/hooks/codex_handoff.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/hooks/codex_handoff.py\""
          },
          {
            "type": "command",
            "command": "[ -n \"${BK_TASK_DIR:-}\" ] || exit 0; f=\"${CLAUDE_PROJECT_DIR:-.}/scripts/agents/task_events.py\"; [ -f \"$f\" ] || f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/agents/task_events.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\""
          }
        ]
      }
    ]
  }
}
